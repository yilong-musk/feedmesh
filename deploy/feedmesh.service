[Unit]
Description=feedmesh — multi-source content to RSS (single binary)
Documentation=file:///home/ubuntu/feedmesh/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/ubuntu/.local/bin/feedmesh serve --listen 127.0.0.1:3000
Environment=FEEDMESH_CACHE=/home/ubuntu/.cache/feedmesh
Restart=always
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
